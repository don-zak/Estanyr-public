{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgt.example/spec/genome_state.schema.json",
  "title": "CGT Public Genome State",
  "description": "Abstract public Cognitive Genome state contract. This is not the private runtime representation.",
  "type": "object",
  "required": [
    "genome_id",
    "version",
    "evidence_level",
    "state"
  ],
  "properties": {
    "genome_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "$ref": "evidence_level.schema.json"
    },
    "state": {
      "type": "object",
      "required": [
        "identity",
        "context",
        "residual_relations",
        "multiscale_structure",
        "transformations",
        "history",
        "evidence",
        "fate"
      ],
      "properties": {
        "identity": {},
        "context": {},
        "residual_relations": {},
        "multiscale_structure": {},
        "transformations": {},
        "history": {},
        "evidence": {},
        "fate": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
